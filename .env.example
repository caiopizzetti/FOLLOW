# ============================================================
#  Exemplo de configuração — NÃO coloque valores reais aqui.
#  Copie para .env.local (que é ignorado pelo git) e preencha.
# ============================================================

# Banco hospedado (Turso). Obrigatório em deploy serverless (Vercel).
# Sem estas duas variáveis a aplicação sobe, mas mostra uma tela
# explicando que o banco não está configurado.
TURSO_DATABASE_URL=libsql://SEU-BANCO-SEU-USUARIO.turso.io
TURSO_AUTH_TOKEN=cole-aqui-o-token-gerado-pelo-turso

# Opcional: caminho do arquivo SQLite usado no desenvolvimento local.
# Se TURSO_DATABASE_URL não estiver definida, a app usa este arquivo.
# FOLLOW_DB_PATH=./data/follow.db
